#version 440

// Fluid cache (FluidSystem): a frame of a volume, as it's drawn (smoke and temperature), saved
// sparsely. One workgroup per brick of 8^3 voxels: a brick with any smoke or heat gets a slot
// (a counter in its frame's table, within the reservation the CPU made) and its voxels go to that
// slot in a page of the brick pool, quantized to 16 bits per channel (two bytes each in an RGBA8
// texel: rg16 images aren't in GLSL ES); an empty brick is left out
// (table entry 0). fluid_brick_unpack.comp makes the dense field again.
//
// Quantization: values of any size into 0..1, finer near 0 (where the smoke fades):
//   smoke s >= 0:  s / (1 + s)            temperature t:  0.5 + 0.5 * t / (1 + |t|)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in; // one brick

layout(std140, binding = 0) uniform CopyBuf {
    uvec4 grid; // xyz = voxels along each axis
};

layout(binding = 1) uniform sampler3D densityIn; // x = smoke, y = temperature

// The frame's table: header (filled by the CPU, `count` by this pass), then one entry per brick
// (x fastest): 0 = empty, 0xFFFFFFFF = left out (no slot left), else 1 + the brick's slot in the
// page (slots of a page: x fastest, 32 x 32 x 32 bricks).
layout(std430, binding = 2) buffer FrameTable {
    uint count;   // bricks given a slot (counted even past the reservation: the CPU checks it)
    uint base;    // first slot of the reservation, in the page
    uint reserve; // slots reserved for this frame
    uint pad;
    uint entries[];
};

layout(binding = 3, rgba8) uniform writeonly image3D page;

const float Empty = 1e-4; // below this, smoke and heat count as nothing
shared uint occupied;
shared uint slot;

void main()
{
    ivec3 brick = ivec3(gl_WorkGroupID);
    ivec3 local = ivec3(gl_LocalInvocationID);
    ivec3 cell = brick * 8 + local;
    bool inside = all(lessThan(uvec3(cell), grid.xyz));
    vec2 v = inside ? texelFetch(densityIn, cell, 0).xy : vec2(0.0);

    if (gl_LocalInvocationIndex == 0u)
        occupied = 0u;
    barrier();
    if (inside && (v.x > Empty || abs(v.y) > Empty))
        atomicOr(occupied, 1u);
    barrier();

    uvec3 bricks = (grid.xyz + 7u) / 8u;
    uint index = uint(brick.x) + bricks.x * (uint(brick.y) + bricks.y * uint(brick.z));
    if (gl_LocalInvocationIndex == 0u) {
        uint entry = 0u;
        if (occupied != 0u) {
            uint n = atomicAdd(count, 1u);
            entry = n < reserve ? base + n + 1u : 0xFFFFFFFFu;
        }
        entries[index] = entry;
        slot = entry;
    }
    barrier();

    if (slot == 0u || slot == 0xFFFFFFFFu)
        return;
    uint s = slot - 1u;
    ivec3 origin = ivec3(int(s % 32u), int((s / 32u) % 32u), int(s / 1024u)) * 8;
    float smoke = max(v.x, 0.0);
    vec2 q = vec2(smoke / (1.0 + smoke), 0.5 + 0.5 * v.y / (1.0 + abs(v.y)));
    uvec2 k = uvec2(round(clamp(q, 0.0, 1.0) * 65535.0)); // 16 bits each: high byte, low byte
    imageStore(page, origin + local, vec4(vec2(k.x >> 8u, k.x & 255u), vec2(k.y >> 8u, k.y & 255u)) / 255.0);
}
