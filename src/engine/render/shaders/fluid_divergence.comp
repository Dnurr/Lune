#version 440

// Fluid solver: divergence. Author: to be written.
//
// How much the velocity spreads out of each voxel (central differences of the neighbors), for
// the pressure solve. Walls: the sides of the box do not let the fluid through.
//
// Until then: no divergence.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in; // FluidSystem::GroupSize

#define MAX_FLUID_SOURCES 8 // FluidSystem::MaxSources

// The step being simulated (FluidSystem in engine/render/fluids.h); the same for every pass of
// a step. Grid coordinates are in voxels: voxel (i, j, k) covers [i, i + 1) x [j, j + 1) x
// [k, k + 1), its center at +0.5; texture coordinates are grid coordinates / grid.xyz.
// Velocities are in voxels per second, along the grid's axes (the box's local axes).
layout(std140, binding = 0) uniform FluidBuf {
    uvec4 grid;    // xyz = voxels along each axis, w = sources this step
    vec4  step;    // x = dt (seconds), y = time at the step's end (seconds), z = voxel size (world units)
    vec4  solver;  // x = dissipation, y = cooling (fractions per second), z = buoyancy, w = weight
                   // (accelerations in world units / s^2: divide by step.z for voxels / s^2)
    vec4  solver2; // x = vorticity (confinement strength)
                   // y, z = stratified air: its temperature at grid point p is
                   // y * dot(p, up.xyz) + z (0 at the box's lowest corner); buoyancy
                   // pushes with the temperature above it
    vec4  up;      // xyz = world up in grid axes (unit length): buoyancy goes along it, weight against it
    // Per source, 3 vec4: center (voxels) and radius (voxels); density and temperature added per
    // second at the center; velocity (voxels / s). Sources are already in grid space.
    vec4  sources[MAX_FLUID_SOURCES * 3];
};

layout(binding = 1) uniform sampler3D velocityIn;   // xyz = velocity (voxels / s); linear filtering, clamped
layout(binding = 5, r32f) uniform writeonly image3D divergenceOut;

vec3 V(ivec3 c)
{
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(grid.xyz)))) return vec3(0.0);
    return texelFetch(velocityIn, c, 0).xyz;
}

void main()
{
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(uvec3(cell), grid.xyz)))
        return;
    
    float div = 0.5 * (
        (V(cell + ivec3(1, 0, 0)).x - V(cell - ivec3(1, 0, 0)).x) +
        (V(cell + ivec3(0, 1, 0)).y - V(cell - ivec3(0, 1, 0)).y) +
        (V(cell + ivec3(0, 0, 1)).z - V(cell - ivec3(0, 0, 1)).z)
    );
    
    imageStore(divergenceOut, cell, vec4(div));
}
