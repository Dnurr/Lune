#version 440

// Fluid solver: MacCormack correction of the advection (FluidVolume::MacCormack)
//
// fluid_advect.comp has just written its semi-Lagrangian result into the predicted fields (the
// fields as they'd be after the step: phi^). The correction measures that advection's error and
// takes half of it back:
//   1. trace forward from the voxel center, with the velocity as it was (velocityIn), and sample
//      the prediction there: phi^ advected back in time, which would be the original field if
//      the advection were exact (phi~)
//   2. the error is (phi - phi~) / 2: phi^ + (phi - phi~) / 2 is the corrected value
//   3. clamp it between the smallest and the largest of the 8 original voxels around the point
//      the semi-Lagrangian trace landed on (otherwise new extremes appear and it can blow up)
// For both fields, velocity and density; the dissipation and cooling are already in phi^.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in; // FluidSystem::GroupSize

#define MAX_FLUID_SOURCES 8 // FluidSystem::MaxSources

// The step being simulated (FluidSystem in engine/render/fluids.h); the same for every pass of
// a step. Grid coordinates are in voxels: voxel (i, j, k) covers [i, i + 1) x [j, j + 1) x
// [k, k + 1), its center at +0.5; texture coordinates are grid coordinates / grid.xyz.
// Velocities are in voxels per second, along the grid's axes (the box's local axes).
layout(std140, binding = 0) uniform FluidBuf {
    uvec4 grid;    // xyz = voxels along each axis, w = sources this step
    vec4  step;    // x = dt (seconds), y = time at the step's end (seconds), z = voxel size (world units)
    vec4  solver;  // x = dissipation, y = cooling (fractions per second), z = buoyancy, w = weight
                   // (accelerations in world units / s^2: divide by step.z for voxels / s^2)
    vec4  solver2; // x = vorticity (confinement strength)
                   // y, z = stratified air: its temperature at grid point p is
                   // y * dot(p, up.xyz) + z (0 at the box's lowest corner); buoyancy
                   // pushes with the temperature above it
    vec4  up;      // xyz = world up in grid axes (unit length): buoyancy goes along it, weight against it
    // Per source, 3 vec4: center (voxels) and radius (voxels); density and temperature added per
    // second at the center; velocity (voxels / s). Sources are already in grid space.
    vec4  sources[MAX_FLUID_SOURCES * 3];
};

layout(binding = 1) uniform sampler3D velocityIn;          // the velocity before the step (voxels / s)
layout(binding = 2) uniform sampler3D densityIn;           // the density before the step
layout(binding = 3) uniform sampler3D predictedVelocity;   // fluid_advect.comp's velocity (phi^)
layout(binding = 4) uniform sampler3D predictedDensity;    // fluid_advect.comp's density (phi^)
layout(binding = 5, rgba16f) uniform writeonly image3D velocityOut;
layout(binding = 6, rgba16f) uniform writeonly image3D densityOut;

void main()
{
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(uvec3(cell), grid.xyz)))
        return;
    
    vec3 p = vec3(cell) + 0.5;
    vec3 v = texelFetch(velocityIn, cell, 0).xyz;

    vec3 fwd = (p + v * step.x) / vec3(grid.xyz);

    vec4 vTilde = textureLod(predictedVelocity, fwd, 0.0);
    vec4 dTilde = textureLod(predictedDensity,  fwd, 0.0);

    vec4 v0 = texelFetch(velocityIn, cell, 0);
    vec4 d0 = texelFetch(densityIn,  cell, 0);

    vec4 vHat = texelFetch(predictedVelocity, cell, 0);
    vec4 dHat = texelFetch(predictedDensity,  cell, 0);

    vec4 vel = vHat + 0.5 * (v0 - vTilde);
    vec4 den = dHat + 0.5 * (d0 - dTilde);

    vec3 b     = p - v * step.x;
    ivec3 b0   = ivec3(floor(b - 0.5));
    ivec3 last = ivec3(grid.xyz) - 1;

    vec4 minV = vec4(1e30), maxV = vec4(-1e30);
    vec4 minD = vec4(1e30), maxD = vec4(-1e30);

    for (int dz = 0; dz <= 1; dz++)
    {
        for (int dy = 0; dy <= 1; dy++)
        {
            for (int dx = 0; dx <= 1; dx++)
            {
                ivec3 c = clamp(b0 + ivec3(dx, dy, dz), ivec3(0), last);

                vec4 vel1 = texelFetch(velocityIn, c, 0);
                vec4 den1 = texelFetch(densityIn,  c, 0);

                minV = min(minV, vel1); maxV = max(maxV, vel1);
                minD = min(minD, den1); maxD = max(maxD, den1);
            }
        }
    }

    vec4 keep = vec4(exp(-solver.x * step.x), exp(-solver.y * step.x), 1.0, 1.0);
    vel = clamp(vel, minV, maxV);
    den = clamp(den, minD * keep, maxD);
    
    imageStore(velocityOut, cell, vel);
    imageStore(densityOut, cell, den);
}
