#version 440

// GPU particle simulation (ParticleSystem in engine/render/particles.h).
//
// One thread per particle slot of an emitter's ring buffer. Each dispatch runs every
// simulation step due this frame (one step = one timeline frame), and each thread takes its
// particle through all of them: particles don't interact, so no step needs another thread.
//
//   main()            the driver (Claude): which step gives this slot a new particle, ages
//                     particles and recycles dead slots. Not to be changed.
//   emitParticle()    a new particle (Author): where it starts, how fast, how long it lives.
//   updateParticle()  one step of a live particle (Author): motion, forces, color and size
//                     over its life.
//
// A particle is dead when its age reaches its lifetime (position.w >= velocity.w). Slots
// start zeroed: dead.

layout(local_size_x = 256) in; // kWorkgroupSize in particles.cpp

// 64 bytes, also the instance data of particle.vert (location 0..3).
struct Particle
{
    vec4 position; // xyz = world position, w = age in seconds (the driver adds each step's dt)
    vec4 velocity; // xyz = world velocity (units / second), w = lifetime in seconds
    vec4 color;    // linear RGB (HDR, premultiplied by the opacity is up to particle.frag), a = opacity
    vec4 extra;    // x = size (world units), y = rotation (radians), z = random 0..1, w = free
};
layout(std430, binding = 1) buffer Particles { Particle particles[]; };

// The emitter during one step: its animated values at that frame (ParticleEmitter in
// engine/scene/entity.h), colors already linear and multiplied by the intensity.
struct Step
{
    mat4  emitter;    // local -> world (position, rotation, scale): the shape and +Y direction
    vec4  time;       // x = step start, y = step end (seconds from the timeline's start)
    uvec4 spawn;      // particles born before this step (x) and by its end (y), counted from the start
    vec4  shape;      // x = 0 point, 1 sphere (y = radius), 2 box (yzw = edge lengths), 3 disc (y = radius, local XZ)
    vec4  velocity;   // x = speed, y = speed variation (0..1), z = spread (radians, half angle around +Y)
    vec4  life;       // x = lifetime, y = lifetime variation (0..1), z = start size, w = end size
    vec4  startColor; // rgb = linear color x intensity, a = opacity, at birth
    vec4  endColor;   // the same at death
};
layout(std430, binding = 2) readonly buffer Steps { Step steps[]; };

layout(std140, binding = 0) uniform SimBuf {
    uvec4 counts; // x = slots (max particles), y = steps in this dispatch, z = seed
    vec4 params;  // x = dt (seconds per step)
};

// Random numbers: the same for the same particle on every run, so the simulation is
// repeatable. `index` = the particle's number since the start, `channel` = which number (use
// a different one for each random choice of a particle).
uint hash(uint x)
{
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}
float random(uint index, uint channel)
{
    return float(hash(index * 0x9e3779b9u ^ hash(channel + counts.z * 0x632be5abu)) >> 8) / 16777216.0;
}

// --- Author ---------------------------------------------------------------------------

// A particle born at `time` (seconds; within step s), number `index` since the start. The
// stub puts it at the emitter's origin with its lifetime and start look, standing still.
void emitParticle(inout Particle p, Step s, uint index, float time)
{
    // TODO (Author): a point of the shape (s.shape, in the emitter's local space through
    // s.emitter), a direction within s.velocity.z of local +Y, the speed with its variation,
    // the lifetime with its variation (s.life.xy).
    vec3 origin = (s.emitter * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    p.position = vec4(origin, 0.0);
    p.velocity = vec4(0.0, 0.0, 0.0, s.life.x);
    p.color = s.startColor;
    p.extra = vec4(s.life.z, 0.0, random(index, 0u), 0.0);
}

// One step of `dt` seconds for a live particle, ending at `time`. The driver adds dt to the
// age afterwards. The stub changes nothing.
void updateParticle(inout Particle p, Step s, float dt, float time)
{
    // TODO (Author): move it (position += velocity * dt), forces, color and size over its
    // life (age / lifetime: s.startColor -> s.endColor, s.life.z -> s.life.w).
}

// --- Driver ---------------------------------------------------------------------------

void main()
{
    uint slot = gl_GlobalInvocationID.x;
    uint slots = counts.x;
    if (slot >= slots)
        return;
    Particle p = particles[slot];
    for (uint k = 0u; k < counts.y; ++k) {
        Step s = steps[k];
        float t0 = s.time.x, t1 = s.time.y;
        uint n0 = s.spawn.x, n1 = s.spawn.y;
        // The newest particle born in this step that lands in this slot (particle n lives in
        // slot n % slots), if any: it replaces whatever was here.
        if (n1 > n0) {
            uint last = n1 - 1u;
            uint back = (last % slots + slots - slot) % slots;
            if (back <= last && last - back >= n0) {
                uint index = last - back;
                float born = mix(t0, t1, (float(index - n0) + 0.5) / float(n1 - n0));
                p = Particle(vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));
                emitParticle(p, s, index, born);
                updateParticle(p, s, t1 - born, t1);
                p.position.w += t1 - born;
                continue;
            }
        }
        if (p.position.w < p.velocity.w) {
            updateParticle(p, s, t1 - t0, t1);
            p.position.w += t1 - t0;
        }
    }
    particles[slot] = p;
}
