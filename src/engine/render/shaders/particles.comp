#version 440

// GPU particle simulation (ParticleSystem in engine/render/particles.h).
//
// One thread per particle slot of an emitter's ring buffer. Each dispatch runs every
// simulation step due this frame (one step = one timeline frame), and each thread takes its
// particle through all of them: particles don't interact, so no step needs another thread.
//
//   main()            the driver (Claude): which step gives this slot a new particle, ages
//                     particles and recycles dead slots. Not to be changed.
//   emitParticle()    a new particle (Author): where it starts, how fast, how long it lives.
//   updateParticle()  one step of a live particle (Author): motion, forces, color and size
//                     over its life.
//   forceAcceleration()  what one Force component does to a particle (Author).
//   graphAcceleration()  the emitter's particle graph (generated, see the end of the file):
//                     the acceleration from its force nodes; without a graph, the scene's forces.
//
// A particle is dead when its age reaches its lifetime (position.w >= velocity.w). Slots
// start zeroed: dead.

layout(local_size_x = 256) in; // kWorkgroupSize in particles.cpp

// 64 bytes, also the instance data of particle.vert (location 0..3).
struct Particle
{
    vec4 position; // xyz = world position, w = age in seconds (the driver adds each step's dt)
    vec4 velocity; // xyz = world velocity (units / second), w = lifetime in seconds
    vec4 color;    // linear RGB (HDR, premultiplied by the opacity is up to particle.frag), a = opacity
    vec4 extra;    // x = size (world units), y = rotation (radians), z = random 0..1, w = free
};
layout(std430, binding = 1) buffer Particles { Particle particles[]; };

// The emitter during one step: its animated values at that frame (ParticleEmitter in
// engine/scene/entity.h), colors already linear and multiplied by the intensity.
struct Step
{
    mat4  emitter;    // local -> world (position, rotation, scale): the shape and +Y direction
    vec4  time;       // x = step start, y = step end (seconds from the timeline's start)
    uvec4 spawn;      // particles born before this step (x) and by its end (y), counted from the start
    vec4  shape;      // x = 0 point, 1 sphere (y = radius), 2 box (yzw = edge lengths), 3 disc (y = radius, local XZ)
    vec4  velocity;   // x = speed, y = speed variation (0..1), z = spread (radians, half angle around +Y)
    vec4  life;       // x = lifetime, y = lifetime variation (0..1), z = start size, w = end size
    vec4  startColor; // rgb = linear color x intensity, a = opacity, at birth
    vec4  endColor;   // the same at death
    uvec4 forces;     // this step's records in forces[]: x = first, y = count
    uvec4 objects;    // the transforms of the graph's Object nodes in forces[]: x = first, y = count
};
layout(std430, binding = 2) readonly buffer Steps { Step steps[]; };

// A Force component during one step (ParticleForce in engine/scene/entity.h). Its axis is
// the entity's local +Y: normalize(mat3(transform) * vec3(0, 1, 0)); its position is
// transform[3].xyz. Every enabled force of the scene acts on every emitter. For each step:
//     for (uint i = s.forces.x; i < s.forces.x + s.forces.y; ++i)
//         acceleration += forceAcceleration(forces[i], p, time);
struct Force
{
    mat4 transform; // local -> world of the entity carrying it
    vec4 params0;   // x = type (0 gravity, 1 wind, 2 turbulence, 3 attractor, 4 vortex),
                    // y = strength, z = radius (0: everywhere), w = falloff (0..1 of the radius)
    vec4 params1;   // x = drag (wind), y = frequency, z = speed (noise), w = noise (vortex swirls)
    vec4 params2;   // x = pull (vortex, toward the axis), y = lift (vortex, along the axis)
};
layout(std430, binding = 3) readonly buffer Forces { Force forces[]; };

// The emitter's particle graph, defined between the graph markers at the end of the file.
vec3 graphAcceleration(Particle p, Step s, float time);

#define MAX_GRAPH_PARAMS 32 // ParticleGraph::MaxParams

layout(std140, binding = 0) uniform SimBuf {
    uvec4 counts; // x = slots (max particles), y = steps in this dispatch, z = seed
    vec4 params;  // x = dt (seconds per step)
    vec4 graphParams[MAX_GRAPH_PARAMS]; // the graph's unlinked input values
};

// Random numbers: the same for the same particle on every run, so the simulation is
// repeatable. `index` = the particle's number since the start, `channel` = which number (use
// a different one for each random choice of a particle).
uint hash(uint x)
{
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}
float random(uint index, uint channel)
{
    return float(hash(index * 0x9e3779b9u ^ hash(channel + counts.z * 0x632be5abu)) >> 8) / 16777216.0;
}

// --- Author ---------------------------------------------------------------------------
const float PI = 3.14159265359;

// A particle born at `time` (seconds; within step s), number `index` since the start.
void emitParticle(inout Particle p, Step s, uint index, float time)
{
    p.color = s.startColor;
    p.extra = vec4(s.life.z, 0.0, random(index, 0u), 0.0);
    p.extra.y = 2.0 * PI * random(index, 8u);

    float cosT = mix(1.0, cos(s.velocity.z), random(index, 2u));
    float sinT = sqrt(max(0.0, 1.0 - cosT * cosT));
    float phi = 2.0 * PI * random(index, 1u);
    
    vec3 localPoint = vec3(0.0);
    float r1 = random(index, 5u);
    float r2 = random(index, 6u);
    float r3 = random(index, 7u);
    switch (int(s.shape.x)) {
        case 0:
            break;
        case 1: {
            float r    = s.shape.y;
            float cosS = 1.0 - 2.0 * r1;
            float sinS = sqrt(max(0.0, 1.0 - cosS * cosS));
            float a    = 2.0 * PI * r2;
            float d    = r * pow(r3, 1.0 / 3.0);
            
            localPoint = vec3(sinS * cos(a), cosS, sinS * sin(a)) * d;

            break;
        }
        case 2: {
            localPoint = (vec3(r1,
                               r2,
                               r3) - 0.5) * s.shape.yzw;
            break;
        }
        case 3: {
            float d = s.shape.y * sqrt(r2);
            float a = 2.0 * PI * r1;
            localPoint = vec3(
                d * cos(a),
                0.0,
                d * sin(a)
            );
            break;
        }
        default:
            break;
    }
    p.position = vec4((s.emitter * vec4(localPoint, 1.0)).xyz, 0.0);

    vec3 dir = normalize(mat3(s.emitter) * vec3(sinT * cos(phi), cosT, sinT * sin(phi)));

    p.velocity.xyz = dir * s.velocity.x * (1.0 - s.velocity.y * random(index, 3u));
    p.velocity.w = s.life.x * (1.0 - s.life.y * random(index, 4u));
}

// A random number 0..1 for each integer point of space (the corners of the noise cells).
float cornerValue(ivec3 c)
{
    uvec3 u = uvec3(c); // negative coordinates keep their bits: they get their own values
    return float(hash(u.x ^ hash(u.y ^ hash(u.z)))) / 4294967295.0;
}

// Value noise: smooth random values over space, 0..1, changing about once per unit.
float valueNoise(vec3 x)
{
    ivec3 c = ivec3(floor(x));        // the cell's corner
    vec3  f = fract(x);               // where x is inside the cell, 0..1 on each axis
    vec3  w = f * f * (3.0 - 2.0 * f); // smoothstep weights: no creases between cells

    // The cell's 8 corners.
    float c000 = cornerValue(c);
    float c100 = cornerValue(c + ivec3(1, 0, 0));
    float c010 = cornerValue(c + ivec3(0, 1, 0));
    float c110 = cornerValue(c + ivec3(1, 1, 0));
    float c001 = cornerValue(c + ivec3(0, 0, 1));
    float c101 = cornerValue(c + ivec3(1, 0, 1));
    float c011 = cornerValue(c + ivec3(0, 1, 1));
    float c111 = cornerValue(c + ivec3(1, 1, 1));

    // Blend them: along x (four edges), then y (two), then z (one).
    float x00 = mix(c000, c100, w.x);
    float x10 = mix(c010, c110, w.x);
    float x01 = mix(c001, c101, w.x);
    float x11 = mix(c011, c111, w.x);
    float y0  = mix(x00, x10, w.y);
    float y1  = mix(x01, x11, w.y);
    return mix(y0, y1, w.z);
}

vec3 potential(vec3 x)
{
    return vec3(valueNoise(x), valueNoise(x + vec3(31.4, 47.2, 12.9)), valueNoise(x + vec3(-19.1, 83.7, 55.3)));
}

vec3 curlNoise(vec3 x)
{
    const float e = 0.01;
    vec3 dx  = vec3(e, 0.0, 0.0), dy  = vec3(0.0, e, 0.0), dz  = vec3(0.0, 0.0, e);
    vec3 px0 = potential(x - dx), px1 = potential(x + dx);
    vec3 py0 = potential(x - dy), py1 = potential(x + dy);
    vec3 pz0 = potential(x - dz), pz1 = potential(x + dz);

    float dzdy = py1.z - py0.z, dydz = pz1.y - pz0.y;
    float dxdz = pz1.x - pz0.x, dzdx = px1.z - px0.z;
    float dydx = px1.y - px0.y, dxdy = py1.x - py0.x;

    return vec3(dzdy - dydz, dxdz - dzdx, dydx - dxdy) / (2.0 * e);
}

// The acceleration (units / s^2) force `f` gives particle `p` at `time`. The stub gives none.
vec3 forceAcceleration(Force f, Particle p, float time)
{
    // TODO (Author): by f.params0.x: gravity along -axis; wind toward a velocity of strength
    // along +axis (drag x (wind velocity - particle velocity)); turbulence as curl noise;
    // attractor toward the position; vortex: spin around the axis line, pull toward it, lift
    // along it, plus local swirls. Then the reach: fade out over the outer `falloff` part of
    // `radius` (from the position, or from the axis for the vortex).
    vec3 axis   = normalize(mat3(f.transform) * vec3(0.0, 1.0, 0.0));
    vec3 center = f.transform[3].xyz;
    vec3 q = p.position.xyz * f.params1.y
           + vec3(0.0, time * f.params1.z, 0.0);

    switch (int(f.params0.x)) {
        case 0: {
            return -axis * f.params0.y;
        }
        case 1: {
            vec3 windVel = axis * f.params0.y;
            return f.params1.x * (windVel - p.velocity.xyz);
        }
        case 2: {
            vec3 acc = curlNoise(q) * f.params0.y;
            return acc;
        }
        case 3: {
            vec3 toCenter = center - p.position.xyz;
            return toCenter / max(length(toCenter), 1e-4) * f.params0.y;
        }
        case 4: {
            vec3 rel    = p.position.xyz - center;
            float along = dot(rel, axis);
            vec3 radial = rel - axis * along;
            float dist  = length(radial);
            vec3 outDir = radial / max(dist, 1e-4);

            vec3 tangent = cross(axis, outDir);

            vec3 acc = tangent * f.params0.y
                     - outDir  * f.params2.x
                     + axis    * f.params2.y;

            acc += curlNoise(q) * f.params1.w;
            
            return acc;
        }
        default:
            break;
    }
    
    return vec3(0.0);
}

// One step of `dt` seconds for a live particle, ending at `time`. The driver adds dt to the
// age afterwards.
void updateParticle(inout Particle p, Step s, float dt, float time)
{
    p.velocity.xyz += graphAcceleration(p, s, time) * dt;
    p.position.xyz += p.velocity.xyz * dt;

    float t   = clamp(p.position.w / p.velocity.w, 0.0, 1.0);
    p.color   = mix(s.startColor, s.endColor, t);
    p.extra.x = mix(s.life.z, s.life.w, t);
}

// --- Particle graph (Claude) ---------------------------------------------------------
// Replaced by the emitter's graph when it has one (ParticleGraph in
// engine/material/particlegraph.h): the node functions of particle_nodes.glsl, then a
// graphAcceleration() made from the graph. Without a graph: every Force component of the
// scene, as the default graph (Scene Forces -> Particle Output) does.
//@graph-begin
vec3 graphAcceleration(Particle p, Step s, float time)
{
    vec3 acceleration = vec3(0.0);
    for (uint i = s.forces.x; i < s.forces.x + s.forces.y; ++i)
        acceleration += forceAcceleration(forces[i], p, time);
    return acceleration;
}
//@graph-end

// --- Driver ---------------------------------------------------------------------------

void main()
{
    uint slot = gl_GlobalInvocationID.x;
    uint slots = counts.x;
    if (slot >= slots)
        return;
    Particle p = particles[slot];
    for (uint k = 0u; k < counts.y; ++k) {
        Step s = steps[k];
        float t0 = s.time.x, t1 = s.time.y;
        uint n0 = s.spawn.x, n1 = s.spawn.y;
        // The newest particle born in this step that lands in this slot (particle n lives in
        // slot n % slots), if any: it replaces whatever was here.
        if (n1 > n0) {
            uint last = n1 - 1u;
            uint back = (last % slots + slots - slot) % slots;
            if (back <= last && last - back >= n0) {
                uint index = last - back;
                float born = mix(t0, t1, (float(index - n0) + 0.5) / float(n1 - n0));
                p = Particle(vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));
                emitParticle(p, s, index, born);
                updateParticle(p, s, t1 - born, t1);
                p.position.w += t1 - born;
                continue;
            }
        }
        if (p.position.w < p.velocity.w) {
            updateParticle(p, s, t1 - t0, t1);
            p.position.w += t1 - t0;
        }
    }
    particles[slot] = p;
}
