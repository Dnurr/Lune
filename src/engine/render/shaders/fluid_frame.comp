#version 440

// Fluid cache (FluidSystem): a frame of a volume as it's drawn, smoke and temperature, copied
// out of its density into a texture of its own (half floats; what fluid_volume.frag
// and fluid_shadow.frag read). Cached frames are drawn from these without simulating.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in; // FluidSystem::GroupSize

layout(std140, binding = 0) uniform CopyBuf {
    uvec4 grid; // xyz = voxels along each axis
};

layout(binding = 1) uniform sampler3D densityIn; // x = smoke, y = temperature
layout(binding = 2, rgba16f) uniform writeonly image3D frameOut;

void main()
{
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(uvec3(cell), grid.xyz)))
        return;
    imageStore(frameOut, cell, vec4(texelFetch(densityIn, cell, 0).xy, 0.0, 0.0));
}
